[Unit]
Description=A Language All Their Own independent X publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/alanguagealltheirown
Environment=TWEET_ENABLE=1
Environment=UPLOAD_POST_USER=iso
Environment=TWEET_STATE_PATH=/var/lib/alanguagealltheirown-x/tweet-state.json
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/alanguagealltheirown-x
ExecStart=/usr/bin/python3 /root/alanguagealltheirown/tweet.py
